BASE_PATH= /
API_URL=http://localhost:8080/
# Placeholder only. This value is read as NEXT_PUBLIC_AUTH_SECRET_KEY in lib/user.ts, so it is visible in the browser
# bundle and must never be a real secret. Use a different random value in every real environment.
AUTH_SECRET_KEY=replace-with-a-random-value
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_CUSTOMER_WEB_URL=http://localhost:3001
# The Branch link domain used by the Campaign links page (for example sipp.app.link). Optional.
NEXT_PUBLIC_BRANCH_LINK_DOMAIN=
